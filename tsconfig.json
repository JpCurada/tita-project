{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@convex/*": [
        "./convex/*"
      ]
    }
  },
  "include": [
    "*.mjs",
    "*.ts",
    ".next/types/**/*.ts",
    "convex/**/*.ts",
    "next-env.d.ts",
    "scripts/**/*.mts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next-build/types/**/*.ts"
  ],
  // convex/tsconfig.json is JSONC (the Convex CLI writes it with comments).
  // A bare "**/*" include sweeps it into Next's config scan, whose strict
  // JSON.parse then fails the whole dev server with a parse error.
  "exclude": [
    "node_modules",
    "convex/tsconfig.json",
    "convex/_generated/ai"
  ]
}
